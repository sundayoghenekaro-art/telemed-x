# Supabase Configuration
# These environment variables are required for the application to connect to Supabase

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (used for client-side authentication)
# Note: Both VITE_SUPABASE_ANON_KEY and VITE_SUPABASE_PUBLISHABLE_KEY should have the same value
# The codebase uses both names for compatibility
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Defence Learning AI gateway (server-side only)
# Read by the Vite dev middleware in vite.config.ts and never exposed to the browser.
# Do NOT prefix this with VITE_ — that would inline the key into the public bundle.
# In production, set it as a secret on the host running the /api/defence-ai gateway.
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini)
DEFENCE_AI_MODEL=
