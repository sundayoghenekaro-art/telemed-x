# Supabase Configuration
# These environment variables are required for the application to connect to Supabase

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (used for client-side authentication)
# Note: Both VITE_SUPABASE_ANON_KEY and VITE_SUPABASE_PUBLISHABLE_KEY should have the same value
# The codebase uses both names for compatibility
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
